{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "manga-shelf/volume-list",
  "version": "0.1.0",
  "title": "漫画：巻一覧",
  "category": "widgets",
  "icon": "book-alt",
  "description": "この作品に登録された既刊を一覧表示します。",
  "textdomain": "manga-shelf",
  "usesContext": [ "postId", "postType" ],
  "attributes": {
    "showReleaseDate": {
      "type": "boolean",
      "default": true
    },
    "showPurchaseLink": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "align": [ "wide", "full" ],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "manga-shelf-volume-list-editor",
  "style": "manga-shelf-volume-list",
  "render": "file:./render.php"
}
