<?xml version="1.0"?>
<ruleset name="Manga Shelf">
	<description>PHP_CodeSniffer rules for the Manga Shelf plugin.</description>

	<file>manga-shelf.php</file>
	<file>includes</file>
	<file>blocks</file>
	<file>uninstall.php</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="ps"/>
	<arg name="extensions" value="php"/>

	<rule ref="WordPress">
		<!-- The plugin uses Composer PSR-4 class filenames. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="manga-shelf"/>
			</property>
		</properties>
	</rule>
</ruleset>
